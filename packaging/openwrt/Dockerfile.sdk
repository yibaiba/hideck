FROM debian:bookworm-slim

RUN apt-get update && apt-get install -y --no-install-recommends \
      build-essential ca-certificates clang cmake curl file gawk gettext git \
      libncurses-dev libssl-dev ninja-build patch pkg-config python3 python3-setuptools \
      rsync time unzip wget xsltproc xz-utils zstd \
    && rm -rf /var/lib/apt/lists/*

# The caller supplies a pinned official SDK URL and its SHA-256, not "latest".
ARG SDK_URL
ARG SDK_SHA256
COPY packaging/openwrt/fetch-sdk.sh /usr/local/bin/fetch-openwrt-sdk
# fetch-sdk.sh checks the official URL and digest and resumes interrupted transfers.
# Three attempts fit the 900 second docker build timeout in openwrt-packages.yml.
RUN SDK_FETCH_ATTEMPTS=3 sh /usr/local/bin/fetch-openwrt-sdk "$SDK_URL" /tmp/sdk.tar.zst "$SDK_SHA256" \
    && printf '%s  /tmp/sdk.tar.zst\n' "$SDK_SHA256" | sha256sum -c - \
    && mkdir /sdk && tar --zstd -xf /tmp/sdk.tar.zst -C /sdk --strip-components=1 \
    && rm /tmp/sdk.tar.zst

WORKDIR /sdk
ENV FORCE_UNSAFE_CONFIGURE=1
